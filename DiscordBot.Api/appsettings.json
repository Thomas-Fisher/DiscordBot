{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=discord_bot;User Id=discord_bot;Password=discord_bot_dev;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "WindowMinutes": 1,
    "MaxRequestsPerWindow": 100,
    "BypassIPs": [],
    "EndpointLimits": {
      "/api/auth/*": 20,
      "/api/logs/*": 50,
      "/api/events/*": 60,
      "/api/settings/*": 60,
      "/health*": 20
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000", "http://localhost:5173" ]
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Discord": {
    "CommandScope": "Global",
    "RedirectUri": "http://localhost:5000/callback",
    "ApiBaseUrl": "https://discord.com/api/v10"
  },
  "Jwt": {
    "Secret": "your-super-secret-jwt-key-min-32-characters-long",
    "Issuer": "discord-bot-api",
    "Audience": "discord-bot-web",
    "ExpiryMinutes": 15,
    "RefreshExpiryDays": 7
  },
  "EventBus": {
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "TopicPrefix": "discordbot",
      "ConsumerGroupId": "discordbot-api",
      "Partitions": 3,
      "ReplicationFactor": 1,
      "MaxDeliveryAttempts": 5,
      "RetryBackoffMilliseconds": 500,
      "ProduceTimeoutSeconds": 30
    }
  },
  "Retention": {
    "Enabled": true,
    "MessageLogDays": 30,
    "ActivityLogDays": 90,
    "ProcessedEventDays": 7,
    "IntervalHours": 6
  },
  "EventReminders": {
    "Enabled": true,
    "CheckIntervalSeconds": 60
  },
  "Recurrence": {
    "CheckIntervalSeconds": 60
  }
}
