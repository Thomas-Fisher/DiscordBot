# Your Discord details and the login signing key. Copy this file to .env (next to docker-compose.yml, git-ignored) and
# replace the four placeholders. The same file is used by `dotnet run` (in Development) and by Docker Compose.
# Where to find each value is in the README (step 3). NEVER commit real values.

Discord__BotToken=REPLACE-WITH-YOUR-BOT-TOKEN
Discord__ClientId=REPLACE-WITH-YOUR-CLIENT-ID
Discord__ClientSecret=REPLACE-WITH-YOUR-CLIENT-SECRET

# Signs the dashboard's login tokens: any random string of 32 or more characters
Jwt__Secret=REPLACE-WITH-A-LONG-RANDOM-STRING-OF-32-PLUS-CHARS
